---
import BaseLayout from '@layouts/Base.astro';
import NavBar from '@components/scafold/Nav.astro';
import Footer from '@components/scafold/Footer.astro';
import { CYBERBRO_SETTINGS_STORAGE_KEY, defaultCyberbroSettings } from '@/config/cyberbro';

const runtime = `
(() => {
  const CYBERBRO_STORAGE_KEY = ${JSON.stringify(CYBERBRO_SETTINGS_STORAGE_KEY)};
  const defaultsCyberbro = ${JSON.stringify(defaultCyberbroSettings)};

  const cyberbroForm = document.getElementById('cyberbro-form');
  const cyberbroStatus = document.getElementById('cyberbro-status');
  const resetCyberbroBtn = document.getElementById('reset-cyberbro');

  const setCyberbroStatus = (message) => {
    if (cyberbroStatus) cyberbroStatus.textContent = message;
  };

  const populateCyberbro = () => {
    if (!cyberbroForm) return;
    let settings = defaultsCyberbro;
    try {
      const raw = window.localStorage.getItem(CYBERBRO_STORAGE_KEY);
      settings = raw ? { ...defaultsCyberbro, ...JSON.parse(raw) } : defaultsCyberbro;
    } catch {}

    cyberbroForm.querySelectorAll('[name]').forEach((field) => {
      const key = field.getAttribute('name');
      if (!key) return;
      const value = settings[key];
      if (field.type === 'checkbox') field.checked = Boolean(value);
      else if (value !== undefined && value !== null) field.value = String(value);
    });
  };

  cyberbroForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const fd = new FormData(cyberbroForm);
    const settings = {
      enabled: fd.get('enabled') === 'on',
      baseUrl: fd.get('baseUrl'),
      timeoutMs: fd.get('timeoutMs'),
      engines: fd.get('engines'),
    };
    window.localStorage.setItem(CYBERBRO_STORAGE_KEY, JSON.stringify(settings));
    setCyberbroStatus('Saved. Cyberbro settings will be used on the next results fetch.');
  });

  resetCyberbroBtn?.addEventListener('click', () => {
    window.localStorage.removeItem(CYBERBRO_STORAGE_KEY);
    populateCyberbro();
    setCyberbroStatus('Cyberbro settings reset to env defaults.');
  });

  populateCyberbro();
})();
`;
---

<BaseLayout
  title="Settings | Web Check"
  description="Configure Web Check branding sources and Cyberbro runtime settings."
>
  <div class="web-check-page">
    <NavBar />
    <main>
      <div class="intro card">
        <h1>Settings</h1>
        <p>
          Branding is now env-driven only. It is not editable from the GUI.
        </p>
      </div>

      <div class="editor-grid">
        <section class="card">
          <h2>Branding via uploaded file</h2>
          <p>
            Upload or mount a branding env file onto the host/container, then set
            <code>BRANDING_ENV_FILE</code> to that path.
          </p>
          <pre>BRANDING_ENV_FILE=/branding/branding.full.env</pre>
          <p class="muted small">
            This is the right option when the user can place files on disk or attach them to the container.
          </p>
        </section>

        <section class="card">
          <h2>Branding via URL</h2>
          <p>
            Host a plain-text env file somewhere reachable, then set <code>BRANDING_ENV_URL</code>.
          </p>
          <pre>BRANDING_ENV_URL=https://example.com/branding/full.env</pre>
          <p class="muted small">
            Useful when branding is managed centrally and multiple deployments should share one source.
          </p>
        </section>

        <section class="card full-width">
          <h2>Example env files</h2>
          <p>
            Start from one of these templates, then upload it or host it somewhere accessible.
          </p>
          <ul>
            <li><a href="/branding/branding.minimal.env" target="_blank" rel="noreferrer">branding.minimal.env</a></li>
            <li><a href="/branding/branding.full.env" target="_blank" rel="noreferrer">branding.full.env</a></li>
          </ul>
          <p class="muted small">
            Load order: local <code>.env</code> first, then <code>BRANDING_ENV_URL</code>, then <code>BRANDING_ENV_FILE</code>.
          </p>
          <p class="muted small">
            After changing branding inputs, rebuild and restart the app so generated pages and metadata stay aligned.
          </p>
        </section>
      </div>

      <div class="intro card cyberbro-intro">
        <h1>Cyberbro Integration</h1>
        <p>
          Cyberbro runtime testing still supports browser-local overrides here, because those do not rebrand the app.
        </p>
      </div>

      <form id="cyberbro-form" class="editor-grid cyberbro-grid">
        <section class="card">
          <h2>Runtime settings</h2>
          <label class="checkbox"><input type="checkbox" name="enabled" /> Enable Cyberbro cards</label>
          <label>Cyberbro API base URL<input name="baseUrl" placeholder="http://cyberbro:5000/api" /></label>
          <label>Timeout (ms)<input name="timeoutMs" inputmode="numeric" /></label>
          <label>
            Engines (comma-separated)
            <textarea name="engines" rows="4" placeholder="google_safe_browsing,virustotal,phishtank,threatfox,alienvault,urlscan"></textarea>
          </label>
        </section>

        <section class="card actions">
          <h2>Notes</h2>
          <p class="muted">
            These values affect the Web Check Cyberbro threat cards on future fetches. They do not rewrite the
            server env, and they do not reconfigure the Cyberbro container itself.
          </p>
          <div class="button-row">
            <button type="submit" class="primary">Save Cyberbro settings</button>
            <button type="button" id="reset-cyberbro">Reset to defaults</button>
          </div>
          <p id="cyberbro-status" class="status muted">No Cyberbro override status yet.</p>
        </section>
      </form>
    </main>
    <Footer />
  </div>
  <script is:inline set:html={runtime}></script>
</BaseLayout>

<style lang="scss">
  @use '@styles/global.scss' as *;
  .web-check-page {
    padding-top: 2rem;
    margin: 0 auto;
    min-height: 100vh;
    width: 100vw;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-image: url('/assets/images/background-dots.svg');
    @include mobile-down {
      padding: 0.5rem;
    }
  }

  main {
    width: 80vw;
    margin: 0 auto;
    min-height: 100%;
    flex-grow: 1;
    padding: 3rem 0 2rem 0;
    max-width: 1200px;
  }

  .editor-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
    @include tablet-landscape-down {
      grid-template-columns: 1fr;
    }
  }

  .card {
    background: var(--background);
    border: 1px solid var(--primary-transparent);
    border-radius: 8px;
    padding: 1rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .full-width {
    grid-column: 1 / -1;
  }

  h1, h2 {
    margin-top: 0;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 0.9rem;
    font-weight: 600;
  }

  input, textarea, button, code, pre {
    font: inherit;
  }

  input, textarea, pre {
    background: var(--background-lighter);
    color: var(--text-color);
    border: 1px solid var(--primary-transparent);
    border-radius: 6px;
    padding: 0.75rem;
  }

  pre {
    overflow-x: auto;
    white-space: pre-wrap;
  }

  .checkbox {
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
  }

  .checkbox input {
    width: auto;
    margin: 0;
  }

  .button-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  button {
    background: var(--background-lighter);
    color: var(--text-color);
    border: 1px solid var(--primary-transparent);
    border-radius: 6px;
    padding: 0.8rem 1.2rem;
    cursor: pointer;
  }

  button.primary {
    background: var(--primary);
    color: var(--background);
    border-color: var(--primary);
    font-weight: 700;
  }

  .muted {
    color: var(--text-color-secondary);
  }

  .small {
    font-size: 0.9rem;
  }

  .status {
    margin: 1rem 0 0 0;
  }
</style>
